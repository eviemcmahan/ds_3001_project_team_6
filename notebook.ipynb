    "for year, df in datasets.items():\n",
    "    # For athletes with two team rows in one season, keep the row with the most games (or minutes if games are tied)\n",
    "    df = df.sort_values([\"games\", \"minutes\"], ascending=False)\n",
    "    df = df.drop_duplicates(subset=[\"season\", \"athleteId\"], keep=\"first\")\n",
    "    datasets[year] = df.sort_values(\"athleteId\").reset_index(drop=True)\n",
    "\n",
    "all_stats = pd.concat(datasets.values(), ignore_index=True) # Rebuild combined table from cleaned datasets\n",
    "\n",
    "print(f\"Duplicate athlete-seasons left: {all_stats.duplicated(subset=['season', 'athleteId']).sum()}\") # Check how many duplicates are left\n",
