        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# Overall starter rate and breakdown by season\n",
        "season_summary = (\n",
        "    transfers_d1.groupby(\"season\")\n",
        "    .agg(\n",
        "        total_transfers=(\"starter\", \"count\"),\n",
        "        starters=(\"starter\", \"sum\"),\n",
        "        starter_rate=(\"starter\", \"mean\"),\n",
        "        espn_ranked_count=(\"espn_preseason_rank\", lambda s: s.notna().sum()),\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "season_summary[\"starter_rate_pct\"] = (season_summary[\"starter_rate\"] * 100).round(1)\n",
        "display(season_summary)\n",
        "\n",
        "# Plot transfer volume and starter rate across seasons\n",
        "fig, ax1 = plt.subplots(figsize=(8, 4.5))\n",
        "\n",
        "bars = ax1.bar(\n",
        "    season_summary[\"season\"].astype(str),\n",
        "    season_summary[\"total_transfers\"],\n",
        "    alpha=0.75,\n",
        "    label=\"D1 Transfers (n)\",\n",
        ")\n",
        "ax1.set_xlabel(\"Season\")\n",
        "ax1.set_ylabel(\"Number of D1 Transfers\")\n",
        "ax1.set_ylim(0, season_summary[\"total_transfers\"].max() * 1.2)\n",
        "\n",
        "ax2 = ax1.twinx()\n",
        "line = ax2.plot(\n",
        "    season_summary[\"season\"].astype(str),\n",
        "    season_summary[\"starter_rate\"] * 100,\n",
        "    marker=\"o\",\n",
        "    linewidth=2,\n",
        "    label=\"Starter Rate (%)\",\n",
        ")\n",
        "ax2.set_ylabel(\"Starters (%)\")\n",
        "ax2.set_ylim(0, 100)\n",
        "\n",
        "plt.title(\"D1 Transfer Volume and Starter Rate by Season (Min. 5 Games)\")\n",
        "fig.tight_layout()\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "mbTfQQucEXhb",
      "metadata": {
        "id": "mbTfQQucEXhb"
      },
      "source": [
        "This step aggregates transfers_d1 by season to compute total transfer counts, starter counts, starter percentages, and how many transfers in each season match to an ESPN preseason ranking. The accompanying dual axis chart pairs blue bar counts of Division I transfer volume (left axis, 0 to 1,600) with a connected line showing starter percentage (right axis, 0% to 100%) across the 2021 through 2026 seasons, helping verify whether target balance or transfer volume shifts substantially over time. As shown in the table and graph, transfer volume more than triples across the sample period starting at 411 transfers (212 starters) in 2021, nearly doubling to 807 (447 starters) in 2022 and 801 (437 starters) in 2023, rising to 924 (490 starters) in 2024, and climbing sharply to 1,176 (643 starters) in 2025 and 1,390 (756 starters) in 2026, while ESPN ranked matches remain steady at 92 to 98 players per season from 2022 through 2026 (with 0 in 2021). Despite this sharp growth in transfer volume, the starter rate line remains remarkably flat just above 50% in every season starting at 51.6% in 2021, peaking at 55.4% in 2022, and holding steady at 54.6% in 2023, 53.0% in 2024, 54.7% in 2025, and 54.4% in 2026 confirming that target balance stays consistent over time even as later seasons account for a larger share of total transfers."
      ]
    },
