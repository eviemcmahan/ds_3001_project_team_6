        "# Stability selection: refit the lasso on 100 bootstrap resamples of the training data and count how often each feature is kept\n",
        "from sklearn.utils import resample\n",
        "\n",
        "X_imputed = SimpleImputer(strategy=\"median\").fit_transform(X_train) # Impute\n",
        "X_scaled = StandardScaler().fit_transform(X_imputed) # Scale\n",
        "n_boot = 100 # Use 100 bootstrap resamples\n",
        "kept_counts = pd.Series(0, index=candidate_features) # Keep track of what columns belong to what features\n",
        "\n",
        "for i in range(n_boot):\n",
        "    Xi, yi = resample(X_scaled, y_train.values, random_state=i) # Bootstrap sample\n",
        "    lasso_i = LogisticRegression(l1_ratio=1, solver=\"liblinear\", C=best_C, max_iter=1000, random_state=0).fit(Xi, yi) # Build the lasso model for each sample\n",
        "    kept_counts += (lasso_i.coef_[0] != 0) # True if lasso keeps the feature\n",
        "\n",
        "selection_rate = (kept_counts / n_boot).sort_values(ascending=False)\n",
        "print(selection_rate.round(2).head(15))\n",
        "\n",
        "selection_rate.head(20).sort_values().plot.barh()\n",
        "plt.axvline(0.7, color=\"gray\", linestyle=\"--\", label=\"Cutoff: kept in 70% of resamples\")\n",
        "plt.xlabel(\"Share of bootstrap resamples where the lasso kept the feature\")\n",
        "plt.title(\"Six features are kept in nearly every resample\")\n",
        "plt.legend(loc=\"lower right\")\n",
