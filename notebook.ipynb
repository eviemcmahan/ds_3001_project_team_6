      "source": [
        "# Mean difference between starters and non-starters across numeric candidate features\n",
        "means_by_starter = transfers_d1.groupby(\"starter\")[numeric_candidates].mean().T\n",
        "means_by_starter.columns = [\"non_starter_mean\", \"starter_mean\"]\n",
        "means_by_starter[\"diff_starter_minus_non\"] = (\n",
        "    means_by_starter[\"starter_mean\"] - means_by_starter[\"non_starter_mean\"]\n",
        ")\n",
        "means_by_starter[\"abs_diff\"] = means_by_starter[\"diff_starter_minus_non\"].abs()\n",
        "\n",
        "# Correlation with target ('starter')\n",
        "target_corr = transfers_d1[numeric_candidates].apply(\n",
        "    lambda s: s.corr(transfers_d1[\"starter\"])\n",
        ")\n",
        "means_by_starter[\"corr_with_starter\"] = target_corr\n",
        "\n",
        "top_corr_cols = (\n",
        "    target_corr.abs().sort_values(ascending=False).head(12).index.tolist()\n",
        ")\n",
        "display(means_by_starter.loc[top_corr_cols].round(3))\n",
        "\n",
        "# Correlation matrix among top target-correlated features + starter\n",
        "corr_matrix = transfers_d1[[\"starter\"] + top_corr_cols].corr()\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(9, 7.5))\n",
        "im = ax.imshow(corr_matrix, cmap=\"coolwarm\", vmin=-1, vmax=1)\n",
        "ax.set_xticks(range(len(corr_matrix.columns)))\n",
        "ax.set_yticks(range(len(corr_matrix.columns)))\n",
        "ax.set_xticklabels(corr_matrix.columns, rotation=45, ha=\"right\", fontsize=8)\n",
        "ax.set_yticklabels(corr_matrix.columns, fontsize=8)\n",
        "\n",
        "for r in range(len(corr_matrix.index)):\n",
        "    for c in range(len(corr_matrix.columns)):\n",
        "        val = corr_matrix.iloc[r, c]\n",
        "        ax.text(c, r, f\"{val:.2f}\", ha=\"center\", va=\"center\", fontsize=7, color=\"black\")\n",
        "\n",
        "fig.colorbar(im, ax=ax, shrink=0.8, label=\"Pearson r\")\n",
        "ax.set_title(\"Correlation Matrix: Starter Target & Top Correlated Prior-Season Features\")\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "wqciQL45EkiF",
      "metadata": {
        "id": "wqciQL45EkiF"
      },
      "source": [
        "This block compares average feature values between starters (starter = 1) and non-starters (starter = 0), computes their mean differences and Pearson correlations with starter, and plots a correlation matrix for starter and the top 12 predictors. Future starters average higher values across every top workload and scoring metric, led by assists_per_game_last_year (1.539 vs. 1.035, r = 0.206), minutes_per_game_last_year (21.550 vs. 17.622, r = 0.199), winShares_defensive_per_game_last_year (r = 0.184), fieldGoals_attempted_per_game_last_year (r = 0.181), points_per_game_last_year (8.231 vs. 6.415, r = 0.177), and games_last_year (25.555 vs. 22.084, r = 0.176). In the heatmap, target correlations remain modest across the top row (r = 0.15 to 0.21), whereas strong red blocks reveal heavy collinearity among playing-time and volume features such as points_per_game_last_year and fieldGoals_attempted_per_game_last_year (r = 0.97) or minutes_per_game_last_year and start_rate_last_year (r = 0.87), motivating feature selection to reduce redundancy."
      ]
    },
    {
      "cell_type": "markdown",
      "id": "build-models",
      "metadata": {
        "id": "build-models"
      },
      "source": [
        "# **Build models**"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "models-split-h",
      "metadata": {
        "id": "models-split-h"
      },
      "source": [
        "### Split into training and test data"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 38,
      "id": "6ad0ed04",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "6ad0ed04",
        "outputId": "d2e5b7d5-a434-4294-a112-751705a387fd"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "2026 rows: 1390 (25.2%)\n",
            "Other years rows: 4119 (74.8%)\n"
          ]
        }
      ],
      "source": [
        "test_season = 2026 # Make the most recent season the test set\n",
        "\n",
        "# Calculate % of test season rows vs all rows\n",
        "rows_total = len(transfers_d1)\n",
        "rows_test = (transfers_d1[\"season\"] == test_season).sum()\n",
        "rows_train = (transfers_d1[\"season\"] != test_season).sum()\n",
        "\n",
        "print(f\"2026 rows: {rows_test} ({rows_test / rows_total:.1%})\")\n",
        "print(f\"Other years rows: {rows_train} ({rows_train / rows_total:.1%})\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 39,
      "id": "models-split",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "models-split",
        "outputId": "c344f4c3-9d0c-48e4-8234-7c1640b1e806"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Training transfers: 4119 (seasons 2021 to 2025), starters: 54.1%\n",
            "Test transfers: 1390 (season 2026), starters: 54.4%\n"
          ]
        }
      ],
      "source": [
        "train = transfers_d1[transfers_d1[\"season\"] < test_season] # Train on the 2021 to 2025 transfers\n",
        "test = transfers_d1[transfers_d1[\"season\"] == test_season] # Test on the 2026 transfers (we do not touch these until the Evaluate models section)\n",
        "\n",
        "X_train, y_train = train[candidate_features], train[\"starter\"]\n",
        "X_test, y_test = test[candidate_features], test[\"starter\"]\n",
        "groups_train = train[\"athleteId\"] # Kew rows with the same player id together\n",
        "\n",
        "print(f\"Training transfers: {len(train)} (seasons {train['season'].min()} to {train['season'].max()}), starters: {y_train.mean():.1%}\")\n",
        "print(f\"Test transfers: {len(test)} (season {test_season}), starters: {y_test.mean():.1%}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "models-split-t",
      "metadata": {
        "id": "models-split-t"
      },
      "source": [
        "We decided to do a time-based training/test set data split because the same player could appear in both the training and testing set since some players transfer multiple times, which could give a falsely increased test accuracy score and it matches closely to a standard 75/25 split. We made the 2026 season be the test set and trained on the 2021 to 2025 transfers. This is also a more similar process to how a coach would use the model, predicting a new class of transfers from past classes. The training set has 4,119 transfers with 54.1% starting at their new school and the test set has 1,390 transfers with 54.4% starters. The similar percentage of starters will be helpful when comparing training and testing accuracy."
      ]
    },
    {
      "cell_type": "markdown",
      "id": "fs-intro-h",
      "metadata": {
        "id": "fs-intro-h"
      },
      "source": [
        "### Feature selection"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "fs-intro-t",
      "metadata": {
        "id": "fs-intro-t"
      },
      "source": [
        "Before building our models, we need to choose which of the 37 prior-season features to use. Many of them overlap (for example, three different shooting percentages), and our goal is to narrow down the stats that a coach needs to focus on when choosing which transferes to pursue. We will determine our features only using the training data to ensure the test data doesn't influence feature selection choices and impact test accuracy. We will use one feature selection using lasso logistic regression for the different models we build and test. Since our research question asks which prior-season stats best predict a starting role, we want to use one list of features to compare each model fairly (if each model picked its own features, it would be hard to tell whether the accuracy differences came from the model or the feature selection). WWe chose the lasso because it reduces the number of features by pushing the weights of unhelpful features to exactly zero. Since the lasso is a linear model, the kNN or **the __** might favor different features. To check this, we fit every model twice, once on all 37 features and once on the selected features."
      ]
    },
    {
      "cell_type": "markdown",
      "id": "fs-setup-h",
      "metadata": {
        "id": "fs-setup-h"
      },
      "source": [
        "**Cross-validation**"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 40,
      "id": "fs-setup",
      "metadata": {
        "id": "fs-setup"
      },
      "outputs": [],
      "source": [
        "from sklearn.model_selection import StratifiedGroupKFold, GridSearchCV, cross_val_score\n",
        "from sklearn.pipeline import make_pipeline\n",
        "from sklearn.impute import SimpleImputer\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.base import clone\n",
        "\n",
        "cv = StratifiedGroupKFold(n_splits=5, shuffle=True, random_state=0)"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "fs-setup-t",
      "metadata": {
        "id": "fs-setup-t"
      },
      "source": [
        "We set up the cross-validation first so that feature selection and the models use the same folds. The folds keep every row for the same player together and keep the share of starters similar across folds. We used a stratified group KFold since we are predicting a binary variable (starter or not) and some players appear more than once in the data. Stratifying keeps about 54% starters in every fold, and grouping by player ensures that other transfer rows from the same player aren't included in both the testing and training folds. We are using cross-validation to choose our model parameters, such as the lasso penalty and the number of features, without using the 2026 test set. We will split the training data into 5 folds, train on 4, validate on 1, and rotate through all 5. This makes sure every player is used once for validation and we can average the scores."
      ]
    },
    {
      "cell_type": "markdown",
      "id": "fs-pen-h",
      "metadata": {
        "id": "fs-pen-h"
      },
      "source": [
        "**Selecting the lasso penalty**"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 41,
      "id": "fs-pen",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "fs-pen",
        "outputId": "1ea0ce9d-6b4e-410e-ed11-c763b65cc07e"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "      C  CV accuracy  CV log loss\n",
            " 0.0010       0.4588       0.6931\n",
            " 0.0016       0.4588       0.6931\n",
            " 0.0026       0.4588       0.6931\n",
            " 0.0043       0.5960       0.6765\n",
            " 0.0070       0.5984       0.6652\n",
            " 0.0113       0.6113       0.6580\n",
            " 0.0183       0.6116       0.6549\n",
            " 0.0298       0.6142       0.6536\n",
            " 0.0483       0.6137       0.6530\n",
            " 0.0785       0.6150       0.6530\n",
            " 0.1274       0.6174       0.6533\n",
            " 0.2069       0.6169       0.6538\n",
            " 0.3360       0.6142       0.6545\n",
            " 0.5456       0.6157       0.6551\n",
            " 0.8859       0.6181       0.6556\n",
            " 1.4384       0.6162       0.6559\n",
            " 2.3357       0.6167       0.6561\n",
            " 3.7927       0.6157       0.6563\n",
            " 6.1585       0.6154       0.6565\n",
            "10.0000       0.6150       0.6566\n",
            "\n",
            "Chosen C: 0.0785\n"
          ]
        }
      ],
      "source": [
        "lasso_selector_pipeline = make_pipeline(\n",
        "    SimpleImputer(strategy=\"median\"), # Fill missing values with the training median\n",
        "    StandardScaler(), # Put the features on the same scale\n",
        "    LogisticRegression(l1_ratio=1, solver=\"liblinear\", max_iter=1000, random_state=0) # l1_ratio=1 is the lasso (L1) penalty\n",
        ")\n",
        "\n",
        "penalty_grid = {\"logisticregression__C\": list(np.logspace(-3, 1, 20))} # Smaller C = stronger penalty (used for logistic)\n",
        "search = GridSearchCV( # Tests each candidate penalty and selects the highest accuracy\n",
        "    lasso_selector_pipeline,\n",
        "    penalty_grid,\n",
        "    cv=cv,\n",
        "    scoring={\"accuracy\": \"accuracy\", \"neg_log_loss\": \"neg_log_loss\"},\n",
        "    refit=\"neg_log_loss\") # Choose the penalty by log loss\n",
        "\n",
        "search.fit(X_train, y_train, groups=groups_train) # Fit search\n",
        "\n",
        "best_C = search.best_params_[\"logisticregression__C\"] # The chosen penalty strength\n",
        "penalty_table = pd.DataFrame({\"C\": penalty_grid[\"logisticregression__C\"],\n",
        "                              \"CV accuracy\": search.cv_results_[\"mean_test_accuracy\"],\n",
        "                              \"CV log loss\": -search.cv_results_[\"mean_test_neg_log_loss\"]}) # Flip the sign back so lower is better\n",
        "print(penalty_table.round(4).to_string(index=False))\n",
        "print(f\"\\nChosen C: {best_C:.4f}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "fs-pen-t",
      "metadata": {
        "id": "fs-pen-t"
      },
      "source": [
        "Based on our correlation plot of potential feature variables, we saw that 5 feature pairs had particularly strong correlations, meaning they provide similar information to the model. As a result, we will use lasso to shrink the weights of redundant features to zero and keep a smaller set of the most useful ones. We used lasso (L1) instead of ridge (L2) because we want to identify which prior-season stats are the most important, and lasso shrinks the weights of unhelpful features to zero, which helps us narrow our features, whereas ridge keeps every feature in the model with a smaller weight.\n",
        "\n",
        "We chose the lasso penalty by cross-validation on the training data. Accuracy is almost the same for every `C` from about 0.01 to 10 (between 61.1% and 61.8%), so it cannot tell us which penalty is best. We chose the best penalty by looking at the lowest log loss, which measures how good the predicted probabilities are by taking into account the confident of predictions. Log loss is lowest for `C` between about 0.05 and 0.08 (0.653). It gets worse for stronger penalties (a smaller `C` is a stronger penalty) and rises only slightly for weaker ones (0.657 at `C` = 10). The strongest penalties (`C` of 0.0026 or less) drop every feature, so the model predicts the same outcome for every player and its accuracy falls to 45.9%. We use the chosen `C` of 0.0785 because it minimizes log loss, which has an accuracy of 61.5%."
      ]
    },
    {
      "cell_type": "markdown",
      "id": "fs-curve-h",
      "metadata": {
        "id": "fs-curve-h"
      },
      "source": [
        "**Determining number of features**"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 42,
      "id": "fs-curve",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 1000
        },
        "id": "fs-curve",
        "outputId": "bd68dd28-3c18-4e11-eb66-b4cdb354f1f5"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "                         CV accuracy\n",
            "Number of features kept             \n",
            "5                              0.617\n",
            "8                              0.615\n",
            "10                             0.617\n",
            "15                             0.615\n",
            "20                             0.615\n",
            "25                             0.615\n",
            "37                             0.615\n"
          ]
        },
        {
          "data": {
            "image/png": "",
            "text/plain": [
              "<Figure size 640x480 with 1 Axes>"
            ]
          },
          "metadata": {},
          "output_type": "display_data"
        }
      ],
      "source": [
        "from sklearn.feature_selection import SelectFromModel\n",
        "\n",
        "num_features = [5, 8, 10, 15, 20, 25, 37]\n",
        "\n",
        "# Logistic regression with chosen lasso penalty\n",
        "lasso_model = LogisticRegression(l1_ratio=1, solver=\"liblinear\", C=best_C, max_iter=1000, random_state=0)\n",
        "\n",
        "baseline_accuracy = cross_val_score(\n",
        "    make_pipeline(SimpleImputer(strategy=\"median\"), StandardScaler(), clone(lasso_model)), # Build the model\n",
        "    X_train, y_train, groups=groups_train, cv=cv, scoring=\"accuracy\").mean() # Averages accuracies of all folds into the mean\n",
        "\n",
        "line = []\n",
        "for k in num_features:\n",
        "    lasso_select = SelectFromModel(clone(lasso_model), max_features=k, threshold=-np.inf) # Keep the k features with the largest lasso weights\n",
        "    pipeline = make_pipeline(SimpleImputer(strategy=\"median\"), StandardScaler(), lasso_select, clone(lasso_model)) # Build each model\n",
        "    scores = cross_val_score(pipeline, X_train, y_train, groups=groups_train, cv=cv, scoring=\"accuracy\") # Collect model scores\n",
        "    line.append(scores.mean()) # Add mean to line\n",
        "\n",
        "line_table = pd.DataFrame({\"CV accuracy\": line}, index=num_features) # Build a table showing accuracy by number of features kept\n",
        "line_table.index.name = \"Number of features kept\"\n",
        "print(line_table.round(3))\n",
        "\n",
        "line_table.plot(marker=\"o\", legend=False) # Plot accuracy line\n",
        "plt.axhline(baseline_accuracy, color=\"gray\", linestyle=\"--\", label=f\"All 37 features ({baseline_accuracy:.3f})\") # Plot baseline\n",
        "plt.ylabel(\"Cross-validated accuracy\")\n",
        "plt.title(\"Lasso logistic regression accuracy by number of features kept\")\n",
        "plt.legend()\n",
        "plt.show()"
      ]
    },
